  inputs: ['nc_deltakelse'],
  title: 'Overganger mellom klasser',
  description: 'Seilere fra hovedklassen ett år til hovedklassen året etter (eller ikke i NorgesCup), og nye seilere per klasse. Hovedklasse er klassen med flest regattaer det året.',
  fn: (nc_deltakelse) => {
    const ORDER = ['Optimist', 'RS Feva', 'ILCA 4', 'Brett', '29er', 'ILCA 6', 'Waszp', 'ILCA 7'];
    const cnt = {}, finnes = {};
    nc_deltakelse.forEach(r => {
      const a = String(r.aar), k = r.person + '|' + a;
      cnt[k] = cnt[k] || {}; cnt[k][r.klasse] = (cnt[k][r.klasse] || 0) + 1;
      finnes[r.klasse + '|' + a] = 1;
    });
    const hoved = {};
    Object.entries(cnt).forEach(([k, c]) => {
      hoved[k] = Object.entries(c).sort((x, y) => (y[1] - x[1]) || (ORDER.indexOf(y[0]) - ORDER.indexOf(x[0])))[0][0];
    });
    const years = [...new Set(Object.keys(hoved).map(k => k.split('|')[1]))].sort();
    const out = {};
    const add = (fra_aar, fra, til) => { const k = fra_aar + '|' + fra + '|' + til; out[k] = out[k] || {fra_aar, fra, til, antall: 0}; out[k].antall += 1; };
    Object.entries(hoved).forEach(([k, kl]) => {
      const [p, a] = k.split('|'), neste = String(Number(a) + 1);
      if (!years.includes(neste)) return;
      if (!finnes[kl + '|' + neste]) return;
      add(a, kl, hoved[p + '|' + neste] || 'Ikke i NorgesCup');
    });
    Object.entries(hoved).forEach(([k, kl]) => {
      const [p, a] = k.split('|'), forrige = String(Number(a) - 1);
      if (!years.includes(forrige)) return;
      if (!hoved[p + '|' + forrige]) add(forrige, 'Ny i NorgesCup', kl);
    });
    return Object.values(out);
  }
});

dash.calc('nc_frafall', {
  inputs: ['nc_overgang'],
  title: 'Året etter per klasse',
  description: 'Per klasse og år: seilere som fortsetter i samme klasse, bytter klasse eller ikke er med i NorgesCup året etter.',
  fn: (nc_overgang) => {
    const by = {};
    nc_overgang.filter(r => r.fra !== 'Ny i NorgesCup').forEach(r => {
      const k = r.fra + '|' + r.fra_aar;
      const d = by[k] = by[k] || {klasse: r.fra, aar: r.fra_aar, samme: 0, annen: 0, ute: 0};
      if (r.til === r.fra) d.samme += r.antall; else if (r.til === 'Ikke i NorgesCup') d.ute += r.antall; else d.annen += r.antall;
    });
    return Object.values(by).map(d => ({...d, totalt: d.samme + d.annen + d.ute}));
  }
});

dash.calc('nc_nokkel', {
  inputs: ['nc_deltakelse', 'nc_frafall'],
  title: 'Nøkkeltall',
  description: 'Unike seilere i perioden, og andel som fortsetter i NorgesCup og som bytter klasse året etter.',
  fn: (nc_deltakelse, nc_frafall) => {
    const p = {}; nc_deltakelse.forEach(r => { p[r.person] = 1; });
    let tot = 0, samme = 0, annen = 0;
    nc_frafall.forEach(r => { tot += r.totalt; samme += r.samme; annen += r.annen; });
    const fortsetter = tot ? Math.round((samme + annen) / tot * 100) : 0;
    const bytter = samme + annen ? Math.round(annen / (samme + annen) * 100) : 0;
    return [{seilere: Object.keys(p).length, fortsetter, fortsetter_tekst: fortsetter + ' %', bytter, bytter_tekst: bytter + ' %'}];
  }
});

(function () {
  const fmt = d3.format(',');
  const CAP = 'var(--cds-font-size-caption)';
  const KL = window.NC_KLASSER;
  const C = {samme: dash.colors[0], annen: dash.colors[1], ute: 'var(--cds-chart-muted)'};
  document.getElementById('lg-samme').style.background = C.samme;
  document.getElementById('lg-annen').style.background = C.annen;
  document.getElementById('lg-ute').style.background = C.ute;
  let aarFrafall = 'alle', aarOvergang = 'alle';

  function fail(el) { el.classList.remove('dash-skeleton'); el.innerHTML = ''; const d = document.createElement('div'); d.className = 'nc-fail'; d.textContent = 'Failed to load'; el.appendChild(d); }
  function wait(el) { el.innerHTML = ''; el.classList.add('dash-skeleton'); }
  function tipFor(box) { let t = box.querySelector(':scope > .nc-tip'); if (!t) { t = document.createElement('div'); t.className = 'nc-tip'; t.hidden = true; box.appendChild(t); } return t; }
  function showTip(box, tip, ev, title, lines) {
    tip.innerHTML = '';
    const h = document.createElement('div'); h.className = 't'; h.textContent = title; tip.appendChild(h);
    lines.forEach(([c, n, v]) => {
      const l = document.createElement('div');
      if (c) { const s = document.createElement('i'); s.style.cssText = 'display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px;background:' + c; l.appendChild(s); }
      l.appendChild(document.createTextNode(n + ': ' + v)); tip.appendChild(l);
    });
    tip.hidden = false;
    const r = box.getBoundingClientRect();
    let x = ev.clientX - r.left + box.scrollLeft + 12, y = ev.clientY - r.top + 12;
    if (x + tip.offsetWidth > box.scrollLeft + r.width) x = Math.max(0, ev.clientX - r.left + box.scrollLeft - tip.offsetWidth - 12);
    tip.style.left = x + 'px'; tip.style.top = y + 'px';
  }
  function textWidth(svg, list) { const p = svg.append('text').style('font-size', CAP); let w = 0; list.forEach(t => { p.text(t); w = Math.max(w, p.node().getComputedTextLength()); }); p.remove(); return Math.ceil(w); }
  function td(tr, txt, cls) { const c = document.createElement('td'); c.textContent = txt; if (cls) c.className = cls; tr.appendChild(c); }

  function segButtons(id, years, current, onPick) {
    const el = document.getElementById(id);
    const opts = ['alle', ...years];
    if (el.dataset.built !== opts.join(',')) {
      el.innerHTML = '';
      opts.forEach(o => {
        const b = document.createElement('button'); b.type = 'button'; b.dataset.v = o;
        b.textContent = o === 'alle' ? 'Alle år' : o + '→' + (Number(o) + 1);
        b.addEventListener('click', () => onPick(o));
        el.appendChild(b);
      });
      el.dataset.built = opts.join(',');
    }
    el.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.v === current)));
  }

  function multi(el, rows) {
    el.innerHTML = '';
    const years = [...new Set(rows.map(r => r.aar))].sort();
    const max = d3.max(rows, r => r.seilere) || 1;
    KL.forEach(k => {
      const box = document.createElement('div'); box.className = 'nc-mini';
      const h = document.createElement('h3'); h.textContent = k; box.appendChild(h);
      el.appendChild(box);
      const W = box.clientWidth || 240, H = 130, m = {l: 4, r: 4, t: 14, b: 18};
      const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);
      const x = d3.scaleBand(years, [m.l, W - m.r]).padding(0.2);
      const y = d3.scaleLinear([0, max], [H - m.b, m.t]);
      const tip = tipFor(box);
      years.forEach(a => {
        const r = rows.find(d => d.klasse === k && d.aar === a), cx = x(a) + x.bandwidth() / 2;
        if (r) {
          const g = svg.append('g');
          g.append('rect').attr('x', x(a)).attr('width', x.bandwidth()).attr('y', y(r.seilere)).attr('height', y(0) - y(r.seilere)).attr('rx', 2).style('fill', dash.colors[0]);
          g.append('text').attr('x', cx).attr('y', y(r.seilere) - 3).attr('text-anchor', 'middle').style('font-size', '10px').style('fill', 'var(--color-fg-muted)').text(fmt(r.seilere));
          g.on('mousemove', ev => showTip(box, tip, ev, k + ' ' + a, [[null, 'Seilere', fmt(r.seilere)], [null, 'Regattaer', fmt(r.regattaer)], [null, 'Båter per regatta', String(r.snitt_baater).replace('.', ',')]])).on('mouseleave', () => { tip.hidden = true; });
        }
        svg.append('text').attr('x', cx).attr('y', H - 4).attr('text-anchor', 'middle').style('font-size', '10px').style('fill', 'var(--color-fg-muted)').text("'" + a.slice(2));
      });
      svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(0)).attr('y2', y(0)).style('stroke', 'var(--cds-chart-axis)');
    });
  }

  function table(rows) {
    const years = [...new Set(rows.map(r => r.aar))].sort();
    const head = document.getElementById('tbl-head');
    if (head.dataset.built !== years.join(',')) {
      head.querySelectorAll('th:not(:first-child)').forEach(th => th.remove());
      years.forEach(a => { const th = document.createElement('th'); th.textContent = a; head.appendChild(th); });
      head.dataset.built = years.join(',');
    }
    const tb = document.querySelector('#tbl-klasse tbody'); tb.innerHTML = '';
    KL.forEach(k => {
      const tr = document.createElement('tr'); td(tr, k);
      years.forEach(a => { const r = rows.find(d => d.klasse === k && d.aar === a); td(tr, r ? fmt(r.seilere) + ' / ' + r.regattaer : '–', r ? '' : 'muted'); });
      tb.appendChild(tr);
    });
  }

  function frafallChart(el, rows) {
    el.classList.remove('dash-skeleton'); el.innerHTML = '';
    const agg = KL.map(k => {
      const rs = rows.filter(r => r.klasse === k && (aarFrafall === 'alle' || r.aar === aarFrafall));
      const s = {klasse: k, samme: d3.sum(rs, r => r.samme), annen: d3.sum(rs, r => r.annen), ute: d3.sum(rs, r => r.ute)};
      s.totalt = s.samme + s.annen + s.ute; return s;
    }).filter(s => s.totalt > 0);
    const W = el.clientWidth || 400;
    const svg = d3.select(el).append('svg').attr('width', '100%');
    const lw = textWidth(svg, agg.map(s => s.klasse + ' (' + s.totalt + ')'));
    const m = {l: lw + 12, r: 8, t: 4, b: 4}, row = 30, H = m.t + m.b + agg.length * row;
    svg.attr('viewBox', `0 0 ${W} ${H}`).attr('height', H); el.style.minHeight = H + 'px';
    const x = d3.scaleLinear([0, 1], [m.l, W - m.r]);
    const tip = tipFor(el);
    agg.forEach((s, i) => {
      const y = m.t + i * row, g = svg.append('g');
      g.append('text').attr('x', m.l - 8).attr('y', y + row / 2 + 4).attr('text-anchor', 'end').style('font-size', CAP).style('fill', 'var(--color-fg)').text(s.klasse + ' (' + s.totalt + ')');
      let acc = 0;
      [['samme', 'Samme klasse'], ['annen', 'Annen klasse'], ['ute', 'Ikke i NorgesCup']].forEach(([f, n]) => {
        const v = s[f] / s.totalt, x0 = x(acc), x1 = x(acc + v); acc += v;
        g.append('rect').attr('x', x0).attr('y', y + 4).attr('width', Math.max(0, x1 - x0 - 1)).attr('height', row - 8).style('fill', C[f]);
        if (x1 - x0 > 30) g.append('text').attr('x', (x0 + x1) / 2).attr('y', y + row / 2 + 4).attr('text-anchor', 'middle').style('font-size', CAP).style('fill', f === 'ute' ? 'var(--color-fg)' : '#fff').text(Math.round(v * 100) + ' %');
      });
      g.on('mousemove', ev => showTip(el, tip, ev, s.klasse + (aarFrafall === 'alle' ? ', alle år' : ', ' + aarFrafall + '→' + (Number(aarFrafall) + 1)),
        [[C.samme, 'Samme klasse', fmt(s.samme)], [C.annen, 'Annen klasse', fmt(s.annen)], [C.ute, 'Ikke i NorgesCup', fmt(s.ute)]])).on('mouseleave', () => { tip.hidden = true; });
    });
  }

  function matrise(el, rows) {
    el.classList.remove('dash-skeleton'); el.innerHTML = '';
    const rs = rows.filter(r => aarOvergang === 'alle' || r.fra_aar === aarOvergang);
    const fraL = [...KL.filter(k => rs.some(r => r.fra === k)), 'Ny i NorgesCup'];
    const tilL = [...KL.filter(k => rs.some(r => r.til === k)), 'Ikke i NorgesCup'];
    const val = (f, t) => d3.sum(rs.filter(r => r.fra === f && r.til === t), r => r.antall);
    const W0 = el.clientWidth || 400;
    const svg = d3.select(el).append('svg');
    const lw = textWidth(svg, fraL);
    const cw = Math.max(46, Math.min(84, (W0 - lw - 20) / tilL.length)), row = 28;
    const m = {l: lw + 12, t: 60, r: 70, b: 4};
    const W = m.l + cw * tilL.length + m.r, H = m.t + fraL.length * row + m.b;
    svg.attr('width', W).attr('height', H).attr('viewBox', `0 0 ${W} ${H}`); el.style.minHeight = H + 'px';
    const max = d3.max(fraL.flatMap(f => tilL.map(t => val(f, t)))) || 1;
    const op = d3.scaleSqrt([0, max], [0.06, 0.95]);
    tilL.forEach((t, j) => {
      const tx = m.l + j * cw + cw / 2;
      svg.append('text').attr('transform', `translate(${tx},${m.t - 8}) rotate(-30)`).style('font-size', CAP).style('fill', 'var(--color-fg-muted)').text(t);
    });
    const tip = tipFor(el);
    fraL.forEach((f, i) => {
      const y = m.t + i * row, tot = d3.sum(tilL, t => val(f, t));
      svg.append('text').attr('x', m.l - 8).attr('y', y + row / 2 + 4).attr('text-anchor', 'end').style('font-size', CAP).style('fill', 'var(--color-fg)').text(f);
      tilL.forEach((t, j) => {
        const v = val(f, t), x = m.l + j * cw, g = svg.append('g');
        const col = t === 'Ikke i NorgesCup' ? 'var(--color-bad)' : f === t ? dash.colors[0] : dash.colors[1];
        g.append('rect').attr('x', x + 1).attr('y', y + 1).attr('width', cw - 2).attr('height', row - 2).attr('rx', 3).style('fill', v ? col : 'transparent').style('fill-opacity', v ? op(v) : 0).style('stroke', 'var(--color-border-line)');
        if (v) g.append('text').attr('x', x + cw / 2).attr('y', y + row / 2 + 4).attr('text-anchor', 'middle').style('font-size', CAP).style('fill', op(v) > 0.55 ? '#fff' : 'var(--color-fg)').text(fmt(v));
        g.on('mousemove', ev => showTip(el, tip, ev, f + ' → ' + t, [[null, 'Seilere', fmt(v)], [null, 'Andel av raden', tot ? Math.round(v / tot * 100) + ' %' : '–']])).on('mouseleave', () => { tip.hidden = true; });
      });
    });
  }

  function draw() {
    const fr = dash.data('nc_frafall'), og = dash.data('nc_overgang');
    const fEl = document.getElementById('frafall-chart'), mEl = document.getElementById('matrise');
    if (fr.status === 'ok') {
      const ys = [...new Set(fr.data.map(r => r.aar))].sort();
      segButtons('seg-frafall', ys, aarFrafall, v => { aarFrafall = v; draw(); });
      frafallChart(fEl, fr.data);
    } else if (fr.status === 'error') fail(fEl); else wait(fEl);
    if (og.status === 'ok') {
      const ys = [...new Set(og.data.map(r => r.fra_aar))].sort();
      segButtons('seg-overgang', ys, aarOvergang, v => { aarOvergang = v; draw(); });
      matrise(mEl, og.data);
    } else if (og.status === 'error') fail(mEl); else wait(mEl);
  }

  dash.onData(() => {
    ['nc_nokkel', 'nc_aar'].forEach(id => {
      const st = dash.data(id);
      document.querySelectorAll(`[data-source="${id}"][data-field]`).forEach(el => {
        if (st.status !== 'ok') return;
        el.classList.remove('dash-skeleton');
        const r = el.dataset.where ? st.data.find(x => x.aar === el.dataset.where.split('=')[1]) : st.data[Number(el.dataset.row || 0)];
        const v = r ? r[el.dataset.field] : null;
        el.textContent = v == null ? '—' : typeof v === 'string' ? v : fmt(v);
      });
    });
    const kl = dash.data('nc_klasse'), mEl = document.getElementById('multi');
    if (kl.status === 'ok') { multi(mEl, kl.data); table(kl.data); } else if (kl.status === 'error') fail(mEl); else wait(mEl);
    draw();
  });
})();
</script>

